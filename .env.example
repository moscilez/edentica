# Edentica hackathon studio. Copy to .env; never commit real credentials.
EDENTICA_MODE=hackathon
LLM_PROVIDER=cloudru
PORT=3000
HOST=127.0.0.1
# npm run db:setup creates a local cluster and writes its generated password to .env.
DATABASE_URL=postgresql://edentica:CHANGE_ME@127.0.0.1:55432/edentica
# For Docker Compose only: URL-safe password; never commit a real value.
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:3000
ALLOWED_HOSTS=
COOKIE_SECURE=0

# Cloud.ru Evolution Foundation Models only.
# Use your issued API key and an exact model ID from your Cloud.ru catalogue.
CLOUDRU_API_KEY=
CLOUDRU_MODEL=
APP_ENCRYPTION_KEY=
# Optional OpenAI-compatible gateway (Cloud.ru/Qwen or your issued gateway).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Request provider-enforced JSON Schema; unsupported providers fall back to validated JSON.
LLM_STRUCTURED_OUTPUT=1
# Optional web search; without it source verification uses explicit reference URLs.
BRAVE_SEARCH_API_KEY=
# Optional: actual RUB per 1 million tokens for this model.
CLOUDRU_INPUT_RUB_PER_MILLION=
CLOUDRU_OUTPUT_RUB_PER_MILLION=

# Leave blank to use the project's .venv.
PYTHON_PATH=
# Directory containing @oai/artifact-tool for PPTX export.
# Local bundled runtime is detected automatically; Cloud.ru needs provisioning.
ARTIFACT_NODE_MODULES=

# Optional local-only testing through a ChatGPT-authenticated official Codex CLI.
# Set EDENTICA_MODE=local and LLM_PROVIDER=codex; never use this for hackathon runs.
CODEX_CLI_PATH=
# Leave blank for the CLI default model.
CODEX_MODEL=
