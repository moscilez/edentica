# Edentica hackathon studio. Copy to .env; never commit real credentials.
EDENTICA_MODE=hackathon
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/edentica.sqlite
PUBLIC_URL=http://localhost:3000
ALLOWED_HOSTS=
COOKIE_SECURE=0

# Cloud.ru Evolution Foundation Models only.
# Use your issued API key and an exact model ID from your Cloud.ru catalogue.
CLOUDRU_API_KEY=
CLOUDRU_MODEL=
# Optional: actual RUB per 1 million tokens for this model.
CLOUDRU_INPUT_RUB_PER_MILLION=
CLOUDRU_OUTPUT_RUB_PER_MILLION=

# Leave blank to auto-detect the bundled Windows Python runtime.
# For Linux/Docker set the Python executable with requirements.txt installed.
PYTHON_PATH=
# Directory containing @oai/artifact-tool for PPTX export.
# Local bundled runtime is detected automatically; Cloud.ru needs provisioning.
ARTIFACT_NODE_MODULES=
