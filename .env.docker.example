# Copy to .env.docker. Use: docker compose --env-file .env.docker up -d --build
# Long random password: letters, digits, underscore or hyphen (used inside a URL).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
APP_ENCRYPTION_KEY=REPLACE_WITH_ENCRYPTION_KEY
PUBLIC_URL=http://localhost:3000
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8000
ALLOWED_HOSTS=
# Set 1 when PUBLIC_URL uses HTTPS through your reverse proxy.
COOKIE_SECURE=0
CLOUDRU_API_KEY=
CLOUDRU_MODEL=
CLOUDRU_INPUT_RUB_PER_MILLION=
CLOUDRU_OUTPUT_RUB_PER_MILLION=
ADMIN_USER_ID=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
BRAVE_SEARCH_API_KEY=
SYSTEM_LLM_ALLOWED_USERS=
# Enable only if you intentionally share the server's quota with every methodist.
SYSTEM_LLM_SHARED_ACCESS=1
SYSTEM_LLM_ALLOW_PRIVATE_NETWORK=0
